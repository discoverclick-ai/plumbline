  },
  "dependencies": {
    "pg": "^8.13.1",
    "@anthropic-ai/sdk": "^0.115.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "17.10.0-beta.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
