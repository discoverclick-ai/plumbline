{
  "name": "@plumbline/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plumbline record kernel: types, workflow engine, permissions, repositories",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
