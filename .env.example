# Migrations run as the database owner (they need DDL and CREATE ROLE).
OWNER_DATABASE_URL=postgres://owner@localhost:5432/plumbline

# The application connects as plumbline_app, a non-superuser role created by
# migration 0006_rls.sql. Connecting as an owner role that carries BYPASSRLS
# silently disables every row-level security policy: no error, nothing looks
# wrong, and reads simply return other tenants' rows.
DATABASE_URL=postgres://plumbline_app@localhost:5432/plumbline

# Only needed to run the capture interpreter against a real model. The eval
# harness works without it via --provider=selftest.
# ANTHROPIC_API_KEY=
